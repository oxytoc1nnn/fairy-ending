{
  "manifest_version": 3,
  "name": "FMS Reconcile",
  "version": "1.1.0",
  "description": "Xuất tracking, TO, dest của LT Trip ra Excel để đối soát.",
  "permissions": ["scripting"],
  "host_permissions": ["https://spx.shopee.vn/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FMS Reconcile",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
